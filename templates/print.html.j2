{#- Print/PDF source. Self-contained: no JS, no network requests, one language. -#}
<!-- {{ generated_note }} -->
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="UTF-8">
<title>{{ meta.name }} — CV ({{ variant.name }})</title>
<style>
{% raw %}
@page { size: A4; margin: 13mm 14mm 12mm 14mm; }
* { margin: 0; padding: 0; box-sizing: border-box; }
html { font-size: 10pt; }
body {
  font-family: "DejaVu Sans", "Liberation Sans", Arial, Helvetica, sans-serif;
  color: #111;
  background: #fff;
  line-height: 1.34;
}
a { color: #14506e; text-decoration: none; }
header.cv-head { border-bottom: 2px solid #14506e; padding-bottom: 6px; margin-bottom: 9px; display: flex; gap: 12px; align-items: flex-start; }
.cv-head img { width: 74px; height: 74px; border-radius: 50%; object-fit: cover; border: 2px solid #14506e; flex: none; }
.cv-head-text { flex: 1; }
h1 { font-size: 18pt; line-height: 1.15; margin-bottom: 2px; color: #14506e; }
.headline { font-size: 9.6pt; font-weight: bold; }
.tagline { font-size: 9pt; font-style: italic; color: #444; }
.contact { font-size: 8.4pt; margin-top: 4px; color: #333; }
.contact span.sep { color: #999; padding: 0 3px; }
h2 {
  font-size: 11pt; color: #14506e; margin-top: 9px; margin-bottom: 4px;
  border-bottom: 1px solid #cfd9e0; padding-bottom: 1px;
  page-break-after: avoid; break-after: avoid;
}
h3 { font-size: 9.6pt; margin-bottom: 1px; page-break-after: avoid; break-after: avoid; }
p { margin-bottom: 3px; }
ul { margin: 2px 0 4px 15px; }
li { margin-bottom: 1px; }
.job, .project, .edu { margin-bottom: 6px; page-break-inside: avoid; break-inside: avoid; }
.job-meta, .meta { font-size: 8.4pt; color: #555; margin-bottom: 2px; }
.emphasized { font-weight: bold; }
.tags { font-size: 7.8pt; color: #666; margin-top: 2px; }
.learned { font-size: 8.2pt; color: #444; margin-top: 2px; }
.skill-groups { display: flex; flex-wrap: wrap; gap: 0 18px; }
.skill-group { flex: 1 1 46%; min-width: 46%; page-break-inside: avoid; break-inside: avoid; }
.skill-row { display: flex; align-items: center; gap: 6px; font-size: 8.6pt; margin-bottom: 1.5px; }
.skill-row .name { flex: 1; }
.skill-row .bar { width: 46px; height: 5px; background: #e3e8ec; border-radius: 3px; overflow: hidden; flex: none; }
.skill-row .bar > i { display: block; height: 100%; background: #14506e; }
.inline-list { font-size: 9pt; }
footer.cv-foot { margin-top: 10px; padding-top: 4px; border-top: 1px solid #cfd9e0; font-size: 7.8pt; color: #666; }
.two-col { column-count: 2; column-gap: 16px; }
{% endraw %}
</style>
</head>
<body>

<header class="cv-head">
  {% if meta.photo %}
  <img src="{{ meta.photo }}" alt="{{ meta.photo_alt }}">
  {% endif %}
  <div class="cv-head-text">
    <h1>{{ meta.name }}</h1>
    <div class="headline">{{ meta.headline }}</div>
    {% if meta.tagline %}<div class="tagline">{{ meta.tagline }}</div>{% endif %}
    <div class="contact">
      {{ ui.location }}: {{ meta.city }}{% if meta.country %}, {{ meta.country }}{% endif %}
      {% if meta.citizenship %}<span class="sep">|</span>{{ ui.citizenship }}: {{ meta.citizenship }}{% endif %}
      <br>
      {% for link in meta.contact_links %}
      {{ link.label }}: <a href="{{ link.href }}">{{ link.short }}</a>{% if not loop.last %}<span class="sep">|</span>{% endif %}
      {% endfor %}
    </div>
  </div>
</header>

{% for section in sections %}
{% if section.id != 'contact' %}
<h2>{{ section.title }}</h2>

{% if section.id == 'summary' %}
  {% for line in summary %}<p>{{ line }}</p>{% endfor %}

{% elif section.id == 'preferred_roles' %}
  <ul>
    {% for role in preferred_roles %}
    <li{% if role.emphasized %} class="emphasized"{% endif %}>{{ role.text }}{% if role.note %} — {{ role.note }}{% endif %}</li>
    {% endfor %}
  </ul>

{% elif section.id == 'experience' %}
  {% for job in experience %}
  <div class="job">
    <h3>{{ job.role }}</h3>
    <div class="job-meta">{{ job.company }}{% if job.via %} ({{ ui.via }} {{ job.via }}){% endif %}{% if job.period %} &middot; {{ job.period }}{% endif %}</div>
    <p>{{ job.summary }}</p>
    {% if job.highlights %}
    <ul>
      {% for hl in job.highlights %}
      <li{% if hl.emphasized %} class="emphasized"{% endif %}>{{ hl.text }}</li>
      {% endfor %}
    </ul>
    {% endif %}
    {% if job.skills_learned and variant.experience_detail == 'full' %}
    <div class="learned"><strong>{{ ui.skills_learned }}:</strong> {{ job.skills_learned | join(', ') }}</div>
    {% endif %}
  </div>
  {% endfor %}

{% elif section.id == 'skills' %}
  <div class="skill-groups">
    {% for group in skills %}
    <div class="skill-group">
      <h3>{{ group.title }}</h3>
      {% for item in group['items'] %}
      <div class="skill-row">
        <span class="name">{{ item.name }} ({{ item.level_label }})</span>
        {% if item.bar is not none %}<span class="bar"><i style="width:{{ item.bar }}%"></i></span>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% endfor %}
  </div>

{% elif section.id == 'open_source' %}
  {% for project in open_source %}
  <div class="project">
    <h3>{{ project.name }}{% if project.stars is not none %} — {{ project.stars }} {{ ui.stars }}{% if project.forks is not none %}, {{ project.forks }} {{ ui.forks }}{% endif %}{% endif %}</h3>
    <div class="meta"><a href="{{ project.url }}">{{ project.url | replace('https://', '') }}</a></div>
    <p>{{ project.summary }}</p>
    {% if project.tech and variant.experience_detail == 'full' %}
    <div class="tags">{{ project.tech | join(' · ') }}</div>
    {% endif %}
  </div>
  {% endfor %}

{% elif section.id == 'education' %}
  {% for item in education %}
  <div class="edu">
    <strong>{{ item.institution }}</strong> — {{ item.field }}{% if item.period %} &middot; {{ item.period }}{% endif %}<br>
    {% if not item.degree_awarded %}<em>{{ ui.coursework_only }}</em>{% if item.note %} — {% endif %}{% endif %}
    {% if item.note %}{{ item.note }}{% endif %}
  </div>
  {% endfor %}

{% elif section.id == 'languages' %}
  <p class="inline-list">{% for language in languages %}{{ language.name }} ({{ language.cefr }}){% if not loop.last %} &middot; {% endif %}{% endfor %}</p>

{% elif section.id == 'availability' %}
  {% if availability %}<p>{{ availability.text }}{% if availability.ico %} {{ ui.ico_yes }}.{% endif %}</p>{% endif %}
  {% if work_authorization %}<p>{{ work_authorization }}</p>{% endif %}

{% elif section.id == 'interests' %}
  <p class="inline-list">{% for interest in interests %}{{ interest }}{% if not loop.last %} &middot; {% endif %}{% endfor %}</p>

{% elif section.id == 'testimonials' %}
  {% for item in testimonials %}
  <p>“{{ item.quote }}” — {{ item.attribution }}</p>
  {% endfor %}
{% endif %}

{% endif %}
{% endfor %}

<footer class="cv-foot">
  {{ ui.online_version }}: <a href="{{ site_url }}">{{ site_url }}</a>
  &middot; &copy; {{ meta.name }}. {{ ui.rights }}
</footer>

</body>
</html>
